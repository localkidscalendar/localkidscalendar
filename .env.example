# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: API host for serverless routes when developing on localhost
# (defaults to https://localkidscalendar.com). Not needed on the live custom domain.
# VITE_API_BASE_URL=https://localkidscalendar.com

# Public site URL used in emails / unsubscribe links (set in Vercel env)
# VITE_APP_URL=https://localkidscalendar.com
# APP_URL=https://localkidscalendar.com

# Server-only (Vercel Project → Settings → Environment Variables — NOT Vite-prefixed)
# Required for automated Ad Asset + activity photo review (image vision via OpenAI).
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your_anon_public_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
# OPENAI_API_KEY=sk-...

# Resend (admin email send via /api/send-email — server-only, never VITE-prefix)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Local Kids Calendar <onboarding@resend.dev>
# Master kill switch for all Resend sends (default on). Set false to stop outbound email.
# EMAIL_SENDING_ENABLED=true
# Optional signing secret for digest unsubscribe tokens (falls back to CRON_SECRET).
# UNSUBSCRIBE_SECRET=your_long_random_secret
# Resend dashboard webhook signing secret (svix whsec_...) for bounce/complaint suppression.
# RESEND_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://YOUR_DOMAIN/api/resend-webhook  (events: email.bounced, email.complained)

# Stripe ads billing (server-only, never VITE-prefix). Use TEST mode keys during development.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (from the Stripe Dashboard webhook endpoint, or `stripe listen` locally)

# Waitlist processor
# - Admins use /api/process-waitlist and /api/expire-waitlist-offer (your login JWT).
# - Vercel Cron hits /api/cron-process-waitlist with Authorization: Bearer <CRON_SECRET>.
#   (Cron paths reject non-cron auth when CRON_SECRET is set — keep them separate.)
# CRON_SECRET=your_long_random_secret
